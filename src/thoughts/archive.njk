<article class="listing-page"><header class="page-heading"><a class="back-link" href="{{ '/thoughts/' | url }}">← Thoughts</a><p class="eyebrow">THOUGHTS / ARCHIVE</p><h1>Archived writing</h1><p class="lede">Older entries remain available here and at their original addresses.</p></header><ol class="entry-list">{% for item in collections.archivedThoughts %}<li><a class="project-row" href="{{ item.url | url }}"><span class="row-number">{{ loop.index }}</span><span class="row-title">{{ item.data.title }}<span class="project-peek">{{ item.data.description }}</span></span><time class="row-status">{{ item.data.date | date }}</time><span class="row-arrow" aria-hidden="true">↗</span></a></li>{% endfor %}</ol></article>
