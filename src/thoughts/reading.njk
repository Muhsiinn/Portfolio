<article class="listing-page"><header class="page-heading"><a class="back-link" href="{{ '/thoughts/' | url }}">← Thoughts</a><p class="eyebrow">THOUGHTS / SOURCES</p><h1>Reading Notes</h1><p class="lede">Ideas encountered in books, research papers, articles, and other sources.</p></header><ol class="entry-list">{% for item in collections.readingNotes %}<li><a class="project-row" href="{{ item.url | url }}"><span class="row-number">{{ loop.index }}</span><span class="row-title">{{ item.data.title }}<span class="project-peek">{{ item.data.description }}{% if item.data.sourceTitle %} · {{ item.data.sourceTitle }}{% endif %}</span></span><time class="row-status">{{ item.data.date | date }}</time><span class="row-arrow" aria-hidden="true">↗</span></a></li>{% endfor %}</ol></article>
