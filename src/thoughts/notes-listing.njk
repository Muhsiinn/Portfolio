<article class="listing-page"><header class="page-heading"><a class="back-link" href="{{ '/thoughts/' | url }}">← Thoughts</a><p class="eyebrow">THOUGHTS / FIELD ENTRIES</p><h1>Notes</h1><p class="lede">Small observations, experiments, questions, and daily entries.</p><p><a href="{{ '/thoughts/notes/daily/' | url }}">Browse daily notes →</a></p></header><ol class="entry-list">{% for item in collections.notes %}<li><a class="project-row" href="{{ item.url | url }}"><span class="row-number">{{ loop.index }}</span><span class="row-title">{{ item.data.title }}<span class="project-peek">{{ item.data.description }}</span></span><time class="row-status">{{ item.data.date | date }}</time><span class="row-arrow" aria-hidden="true">↗</span></a></li>{% endfor %}{% for item in collections.dailyNotes | reverse %}<li><a class="project-row" href="{{ item.url | url }}"><span class="row-number">·</span><span class="row-title">{{ item.data.title }}<span class="project-peek">Daily note</span></span><time class="row-status">{{ item.data.date | date }}</time><span class="row-arrow" aria-hidden="true">↗</span></a></li>{% endfor %}</ol></article>
