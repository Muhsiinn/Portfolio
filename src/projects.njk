---
layout: layouts/base.njk
title: Projects — Muhsin's notebook
description: Software, small experiments, and things built to understand them better.
permalink: /projects/index.html
---
<section class="archive-page">
  <header class="archive-header"><p class="eyebrow">BUILT, TESTED, STILL LEARNING</p><h1>Projects</h1><p class="lede">Software and experiments made to answer a question, solve a small problem, or learn how a thing works.</p></header>
  <section class="project-group"><p class="eyebrow">COMPLETED</p><h2>Finished projects</h2><ol class="entry-list">
  {% for item in collections.projects %}{% if item.data.status == 'Completed' and not item.data.archived and (not item.data.draft or previewDrafts) %}<li><a class="project-row" href="{{ item.url | url }}"><span class="row-number">{{ loop.index }}</span><span class="row-title">{{ item.data.title }}<span class="project-peek">{{ item.data.description }}{% if item.data.tags %}<span class="peek-tags">{{ item.data.tags | join(' · ') }}</span>{% endif %}</span></span><span class="row-status">COMPLETE</span><span class="row-arrow" aria-hidden="true">↗</span></a></li>{% endif %}{% endfor %}
  </ol></section>
  <section class="project-group"><p class="eyebrow">ONGOING &amp; EXPERIMENTAL</p><h2>Work in progress</h2><ol class="entry-list">
  {% for item in collections.projects %}{% if item.data.status != 'Completed' and not item.data.archived and (not item.data.draft or previewDrafts) %}<li><a class="project-row" href="{{ item.url | url }}"><span class="row-number">{{ loop.index }}</span><span class="row-title">{{ item.data.title }}<span class="project-peek">{{ item.data.description }}{% if item.data.tags %}<span class="peek-tags">{{ item.data.tags | join(' · ') }}</span>{% endif %}</span></span><span class="row-status">{{ item.data.status or 'ONGOING' }}</span><span class="row-arrow" aria-hidden="true">↗</span></a></li>{% endif %}{% endfor %}
  </ol></section>
  {% if collections.archivedProjects.length %}<section class="archive-section"><p class="eyebrow">ARCHIVED</p><h2>Older work</h2><ol class="entry-list">{% for item in collections.archivedProjects %}<li><a class="project-row" href="{{ item.url | url }}"><span class="row-number">↳</span><span class="row-title">{{ item.data.title }}{% if item.data.draft %}<span class="draft-label"> · DRAFT PREVIEW</span>{% endif %}<span class="project-peek">{{ item.data.description }}</span></span><span class="row-status">{{ item.data.status }}</span><span class="row-arrow" aria-hidden="true">↗</span></a></li>{% endfor %}</ol></section>{% endif %}
</section>
