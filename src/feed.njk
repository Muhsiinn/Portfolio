---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Muhsin's Digital Field Notebook</title>
  <id>{{ site.url }}{{ '/' | url }}</id>
  <link href="{{ site.url }}{{ '/feed.xml' | url }}" rel="self"/>
  <link href="{{ site.url }}{{ '/' | url }}"/>
  <updated>{{ currentTime }}</updated>
  <author><name>{{ site.name }}</name></author>
  {% for item in collections.thoughts %}{% if (not item.data.draft or previewDrafts) and item.data.date %}<entry><title>{{ item.data.title | xml | safe }}</title><id>{{ site.url }}{{ item.url | url }}</id><link href="{{ site.url }}{{ item.url | url }}"/><updated>{{ item.data.date | isoDate }}T00:00:00Z</updated><summary>{{ item.data.description | xml | safe }}</summary></entry>{% endif %}{% endfor %}
</feed>
