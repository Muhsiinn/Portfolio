---
layout: layouts/base.njk
---
<article class="reading-page">
  <header class="document-header"><p class="eyebrow">THE PERSON KEEPING THESE NOTES</p><h1>{{ title }}</h1>{% if description %}<p class="lede">{{ description }}</p>{% else %}<p class="lede lazy-placeholder">{{ site.emptySection }}</p>{% endif %}</header>
  <div class="reading-layout"><article class="prose">{% if content | trim %}{{ content | safe }}{% else %}<p class="lazy-placeholder">{{ site.emptySection }}</p>{% endif %}</article></div>
  <section class="education-section" aria-labelledby="education-heading">
    <p class="eyebrow">A LITTLE FORMAL LEARNING</p>
    <h2 id="education-heading">Education</h2>
    {% for item in education.formal %}
    <article class="education-entry">
      <h3>{{ item.degree }}</h3>
      <p>{{ item.institution }} <span>·</span> {{ item.location }} <span>·</span> {{ item.start }}–{{ item.end }}</p>
      {% if item.details %}<p>{{ item.details }}</p>{% endif %}
    </article>
    {% else %}<p class="lazy-placeholder">{{ site.emptySection }}</p>{% endfor %}
  </section>
</article>
