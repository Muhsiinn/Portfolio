---
permalink: /thoughts/notes/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom"><title>Muhsin's Notes</title><id>{{ site.url }}{{ '/thoughts/notes/' | url }}</id><link href="{{ site.url }}{{ '/thoughts/notes/feed.xml' | url }}" rel="self"/><link href="{{ site.url }}{{ '/thoughts/notes/' | url }}"/><updated>{{ currentTime }}</updated><author><name>{{ site.name }}</name></author>{% for item in collections.notes %}<entry><title>{{ item.data.title | xml }}</title><id>{{ site.url }}{{ item.url | url }}</id><link href="{{ site.url }}{{ item.url | url }}"/><updated>{{ item.data.date | isoDate }}T00:00:00Z</updated><summary>{{ item.data.description | xml }}</summary></entry>{% endfor %}{% for item in collections.dailyNotes %}<entry><title>{{ item.data.title | xml }}</title><id>{{ site.url }}{{ item.url | url }}</id><link href="{{ site.url }}{{ item.url | url }}"/><updated>{{ item.data.date | isoDate }}T00:00:00Z</updated><summary>{{ item.data.description | xml }}</summary></entry>{% endfor %}</feed>
